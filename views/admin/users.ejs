<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manage Users - Admin</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <nav class="navbar">
    <div class="container">
      <h1 class="logo"><a href="/">CampusXchange</a></h1>
      <div class="nav-links">
        <a href="/admin/dashboard">Dashboard</a>
        <a href="/admin/users" class="active">Users</a>
        <a href="/admin/items">Items</a>
        <a href="/admin/orders">Orders</a>
        <a href="/">Main Site</a>
        <button onclick="logout()">Logout</button>
      </div>
    </div>
  </nav>

  <main class="container admin-container">
    <div class="admin-header">
      <h2>Manage Users</h2>
      <p>Total Users: <%= users.length %></p>
    </div>

    <div class="table-container">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Joined Date</th>
            <th>Cart Items</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(u => { %>
            <tr>
              <td><%= u.name %></td>
              <td><%= u.email %></td>
              <td>
                <% if (u.role === 'admin') { %>
                  <span class="badge badge-admin">Admin</span>
                <% } else { %>
                  <span class="badge badge-user">User</span>
                <% } %>
              </td>
              <td><%= new Date(u.createdAt).toLocaleDateString() %></td>
              <td><%= u.cart.length %></td>
              <td class="action-buttons-cell">
                <% if (u._id.toString() !== user._id.toString()) { %>
                  <% if (u.role === 'admin') { %>
                    <form method="POST" action="/admin/users/remove-admin/<%= u._id %>" style="display:inline;">
                      <button type="submit" class="btn-sm btn-warning" onclick="return confirm('Remove admin rights?')">
                        Remove Admin
                      </button>
                    </form>
                  <% } else { %>
                    <form method="POST" action="/admin/users/make-admin/<%= u._id %>" style="display:inline;">
                      <button type="submit" class="btn-sm btn-success" onclick="return confirm('Make this user an admin?')">
                        Make Admin
                      </button>
                    </form>
                  <% } %>
                  <form method="POST" action="/admin/users/delete/<%= u._id %>" style="display:inline;">
                    <button type="submit" class="btn-sm btn-danger" onclick="return confirm('Delete this user? This will also delete all their items.')">
                      Delete
                    </button>
                  </form>
                <% } else { %>
                  <span class="text-muted">You (Current Admin)</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </main>

  <script>
    async function logout() {
      const res = await fetch('/auth/logout', { method: 'POST' });
      if (res.ok) window.location.href = '/';
    }
  </script>
</body>
</html>