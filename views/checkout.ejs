<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Order Confirmation - CampusXchange</title>
  <link rel="stylesheet" href="/css/style.css">
  <!-- EmailJS SDK - Version 4 -->
  <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>
</head>
<body>
  <nav class="navbar">
    <div class="container">
      <h1 class="logo"><a href="/">CampusXchange</a></h1>
      <div class="nav-links">
        <a href="/">Home</a>
        <a href="/items/add">Sell Item</a>
        <a href="/cart">Cart</a>
        <button onclick="logout()">Logout</button>
      </div>
    </div>
  </nav>

  <main class="container">
    <div class="checkout-success">
      <div class="success-icon">✓</div>
      <h2>Order Placed Successfully!</h2>
      <p>Your order has been confirmed. The seller(s) will be notified via email.</p>
      
      <!-- Email Status Indicator -->
      <div id="email-status" style="margin: 20px 0; padding: 15px; border-radius: 5px; background-color: #f0f0f0; border: 1px solid #ddd;">
        <p style="margin: 0;">📧 Sending notifications to sellers...</p>
      </div>

      <div class="order-details">
        <h3>Order Details</h3>
        <p><strong>Order ID:</strong> #<%= order._id %></p>
        <p><strong>Total Amount:</strong> ₹<%= order.totalPrice %></p>
        <p><strong>Buyer:</strong> <%= order.buyerName %> (<%= order.buyerEmail %>)</p>
        
        <div class="order-items">
          <h4>Items Ordered:</h4>
          <% order.items.forEach(item => { %>
            <div class="order-item" style="padding: 15px; margin: 10px 0; background: #f9f9f9; border-left: 3px solid #007bff; border-radius: 4px;">
              <p><strong><%= item.itemName %></strong></p>
              <p><%= item.department %> - Semester <%= item.semester %></p>
              <p><strong>Price:</strong> ₹<%= item.price %></p>
              <p class="seller-info"><strong>Seller:</strong> <%= item.sellerName %> (<%= item.sellerEmail %>)</p>
            </div>
          <% }) %>
        </div>
      </div>

      <div class="next-steps">
        <h4>Next Steps:</h4>
        <ul>
          <li>The seller will contact you via email to arrange pickup/delivery</li>
          <li>Check your email for order confirmation</li>
          <li>Complete the transaction directly with the seller</li>
        </ul>
      </div>

      <a href="/" class="btn-primary">Continue Shopping</a>
    </div>
  </main>

  <script>
    console.log('🚀 Checkout page loaded');

    // Initialize EmailJS
    (function() {
      emailjs.init('YiwUqPWnMsioKRJV_');
      console.log('✅ EmailJS initialized with public key');
    })();

    // Get data from server
    const sellerDataJSON = '<%- sellerDataJSON %>';
    const sellerData = JSON.parse(sellerDataJSON);;
    const serviceId = 'service_3orpc5b';
    const templateId = 'template_c9ois3e';

    console.log('📋 Configuration:');
    console.log('Service ID:', serviceId);
    console.log('Template ID:', templateId);
    console.log('Seller Data:', sellerData);

    // Send emails to all sellers
    async function sendEmailsToSellers() {
      const statusDiv = document.getElementById('email-status');
      
      if (!sellerData || sellerData.length === 0) {
        console.error('❌ No seller data available');
        statusDiv.innerHTML = '<p style="color: red; margin: 0;">✗ No sellers to notify</p>';
        statusDiv.style.backgroundColor = '#f8d7da';
        return;
      }

      let successCount = 0;
      let failCount = 0;
      const totalEmails = sellerData.length;

      statusDiv.innerHTML = `<p style="margin: 0;">📧 Sending ${totalEmails} notification(s)...</p>`;
      console.log(`📤 Attempting to send ${totalEmails} email(s)`);

      for (let i = 0; i < sellerData.length; i++) {
        const item = sellerData[i];
        
        try {
          console.log(`\n📧 Email ${i + 1}/${totalEmails}`);
          console.log('To:', item.sellerEmail);
          console.log('Seller:', item.sellerName);
          console.log('Item:', item.itemName);

          const templateParams = {
            to_email: item.sellerEmail,
            seller_name: item.sellerName,
            buyer_name: item.buyerName,
            buyer_email: item.buyerEmail,
            item_name: item.itemName,
            price: item.price
          };

          console.log('Template params:', templateParams);

          const response = await emailjs.send(
            serviceId,
            templateId,
            templateParams
          );

          successCount++;
          console.log('✅ SUCCESS! Email sent to', item.sellerEmail);
          console.log('Response:', response);

        } catch (error) {
          failCount++;
          console.error('❌ FAILED to send to', item.sellerEmail);
          console.error('Error:', error);
          console.error('Error text:', error.text);
          console.error('Error status:', error.status);
        }
      }

      console.log(`\n📊 Results: ${successCount} success, ${failCount} failed`);

      // Update status display
      if (failCount === 0) {
        statusDiv.innerHTML = `<p style="color: green; margin: 0;">✓ All ${successCount} seller(s) have been notified!</p>`;
        statusDiv.style.backgroundColor = '#d4edda';
        statusDiv.style.borderColor = '#c3e6cb';
      } else if (successCount > 0) {
        statusDiv.innerHTML = `<p style="color: orange; margin: 0;">⚠ ${successCount} email(s) sent, ${failCount} failed. Check console for details.</p>`;
        statusDiv.style.backgroundColor = '#fff3cd';
        statusDiv.style.borderColor = '#ffc107';
      } else {
        statusDiv.innerHTML = `<p style="color: red; margin: 0;">✗ Failed to send all notifications. Please check console.</p>`;
        statusDiv.style.backgroundColor = '#f8d7da';
        statusDiv.style.borderColor = '#f5c6cb';
      }
    }

    // Run when page loads
    window.addEventListener('load', () => {
      console.log('📧 Starting email send process...');
      sendEmailsToSellers();
    });

    // Logout function
    async function logout() {
      try {
        const res = await fetch('/auth/logout', { method: 'POST' });
        if (res.ok) {
          window.location.href = '/';
        }
      } catch (error) {
        console.error('Logout error:', error);
      }
    }
  </script>
</body>
</html>